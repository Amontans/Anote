#!/usr/bin/env bash
# ============================================================
#  anote — Anote 科研知识库统一入口
#  用法: anote <命令> [参数]
#  安装: ln -sf "$PWD/anote" ~/.local/bin/anote  （PATH 含 ~/.local/bin）
#  数据目录可在 ~/.config/anote/config 中更改（anote config set data_dir 路径）
# ============================================================
set -e
PROJ=~/Projects/Anote
SKILL=$PROJ/scripts

# 数据目录：优先 ANOTE_DATA 环境变量（测试/临时），再读配置
if [ -n "$ANOTE_DATA" ]; then
  DATA=$ANOTE_DATA
elif [ -f "$HOME/.config/anote/config" ]; then
  DATA=$(grep -E '^data_dir=' "$HOME/.config/anote/config" | head -1 | cut -d= -f2- | sed 's|^~|'"$HOME"'|')
fi
DATA=${DATA:-~/Documents/Anote}
PYV="$DATA/.venv/bin/python"
[ -x "$PYV" ] || PYV=python3   # venv 缺失时回退（语义检索等需 venv 的命令会提示）
EDITOR_CFG=$(grep -E '^editor=' "$HOME/.config/anote/config" 2>/dev/null | cut -d= -f2-)

usage() {
  cat <<'EOF'
anote — Anote 科研知识库统一入口（v0.8.0-dev）

使用:
  anote tui                     打开 TUI 界面（推荐入口）
  anote edit <路径>             用配置的编辑器打开笔记（如 anote edit 数学/代数/xxx.tex）
  anote new <学科/分支> <标题>  新建笔记 [--template note|note-math]
  anote daily                   今日笔记（含队列快照）
  anote search "<关键词>"       检索文献并入队（arXiv/OpenAlex/S2/Crossref）
  anote ask "<问题>"            知识库问答（grep）
  anote ask --semantic "<问题>" 知识库语义问答
  anote ask-pi "<问题>"        经 Pi 回答（可检索知识库）
  anote backlinks "<概念>"       反链：谁引用了这个概念
  anote meta [--ai] [--apply]  META 检查/经 Pi 补全建议
  anote wiki [--dry] [--force] 知识编译：笔记 → 学科主题页
  anote plugin {list\|add\|run}   插件机制
  anote mcp                    MCP Server（外部 AI 工具接入）
  anote test                    一键测试门禁（单测+TUI+自检）
  anote release <maj\|min\|patch> 发布门禁（测试+版本+tag）
  anote report                  周报自动生成
  anote graph [--mermaid]       知识图谱（标签/反链）
  anote web [--port N]          只读浏览外壳（仅 127.0.0.1）
  anote export [--out 路径]     整库打包（可移植/分享）
  anote zotero {status\|bib\|setup}  Zotero 文献接入
  anote bibcheck                引用链路校验（cite↔refs.bib）
  anote index                   重建分层索引
  anote index-semantic          重建语义索引
  anote check                   一致性自检（6 项）
  anote stats                   统计各类文件数
  anote migrate --to <路径>     迁移数据目录（含 .git，安全回滚）
  anote review [--days 30]      生成周/月回顾草稿
  anote project <名> [目标]     新建研究项目
  anote book <书名> [作者]      新建教科书
  anote chapter <书名> <章名>   添加章节
  anote book-build <书名>       编译教科书 PDF
  anote commit [说明]           提交（自动索引+自检）
  anote backup                  提交并推送远程
  anote config                  查看配置
  anote config set <键> <值>    修改配置（如 data_dir / editor / lang）
  anote help                    本帮助

数据目录: $DATA   编辑器: ${EDITOR_CFG:-code}
EOF
}

cmd="$1"; shift || true

case "$cmd" in
  ""|help|-h|--help)
    if [ -n "$1" ]; then
      # anote help <命令>：显示该命令的用法行
      usage | grep -i "^  anote $1\|用法.*$1\|^  $1 " | head -3
      [ $? -ne 0 ] && usage | grep "$1" | head -3
    else
      usage
    fi ;;
  tui) cd "$PROJ" && "$PYV" -m tui ;;
  edit)
    [ -z "$1" ] && { echo "用法: anote edit <相对数据目录的路径>"; exit 1; }
    p="$DATA/$1"; [ -f "$p" ] || { echo "不存在: $p"; exit 1; }
    "${EDITOR_CFG:-code}" "$p" ;;
  config)
    if [ "$1" = "set" ]; then
      "$PYV" "$SKILL/anote_config.py" set "$2" "$3"
    else
      "$PYV" "$SKILL/anote_config.py"
    fi ;;
  new)
    # anote new <学科/分支> <标题> [--template 名]
    dir="$1"; title="$2"; tpl="note"; shift 2 2>/dev/null || true
    if [ "$1" = "--template" ] && [ -n "$2" ]; then tpl="$2"; fi
    [ -z "$dir" ] || [ -z "$title" ] && { echo "用法: anote new <学科/分支> <标题> [--template 名]"; exit 1; }
    TF="$PROJ/templates/$tpl.tex"
    [ -f "$TF" ] || TF="$PROJ/templates/note.tex"
    path="$DATA/src/$dir"; mkdir -p "$path"
    f="$path/$(date +%F)_$(echo "$title" | tr ' ' '_').tex"
    sed -e "s|%%DISC%%|${dir%/*}|g" -e "s|%%BRANCH%%|${dir##*/}|g" \
        -e "s|%%TITLE%%|$title|g" -e "s|%%DATE%%|$(date +%F)|g" "$TF" > "$f"
    echo "✓ 已创建: $f（模板: $tpl）"
    "${EDITOR_CFG:-code}" "$f" 2>/dev/null || true ;;
  search)
    [ -z "$1" ] && { echo "用法: anote search \"<关键词>\" [--max 10]"; exit 1; }
    "$PYV" "$SKILL/search.py" --provider arxiv --query "$1" --queue "$DATA/queue.md" "${@:2}" ;;
  ask)
    "$PYV" "$SKILL/ask.py" "$@" ;;
  ask-pi)
    # anote ask-pi "<问题>" —— 经 Pi（agent）回答问题
    [ -z "$1" ] && { echo "用法: anote ask-pi \"<问题>\""; exit 1; }
    pi -p "$*" ;;
  ask-ai)
    "$PYV" "$SKILL/ask.py" "$@" ;;
  zotero)
    # anote zotero {status|bib|setup}
    python3 "$SKILL/zotero.py" "$@" ;;
  bibcheck)
    python3 "$SKILL/bibcheck.py" ;;
  web)
    # anote web [--port N] [--token xxx] —— 只读浏览外壳
    "$PYV" "$SKILL/web_server.py" "$@" ;;
  export)
    python3 "$SKILL/export.py" "$@" ;;
  report)
    python3 "$SKILL/report.py" "$@" ;;
  graph)
    python3 "$SKILL/graph.py" "$@" ;;
  release)
    # anote release <major|minor|patch> —— 发布门禁
    bash "$PROJ/scripts/release.sh" "$@" ;;
  test)
    # anote test —— 一键测试门禁
    bash "$PROJ/scripts/run-tests.sh" ;;
  mcp)
    # anote mcp —— MCP Server（stdio，供外部 AI 工具调用）
    "$PYV" "$SKILL/mcp_server.py" ;;
  plugin)
    # anote plugin {list|add|run}
    sub="$1"; shift 2>/dev/null || true
    PLUG="$PROJ/plugins"
    case "$sub" in
      list)
        for f in "$PLUG"/*.py; do [ -f "$f" ] && echo "  $(basename "$f" .py)"; done ;;
      add)
        [ -z "$1" ] && { echo "用法: anote plugin add <脚本.py>"; exit 1; }
        cp "$1" "$PLUG/" && echo "✓ 已安装: $(basename "$1")" ;;
      run)
        [ -z "$1" ] && { echo "用法: anote plugin run <名> [参数…]"; exit 1; }
        p="$PLUG/$1.py"; shift
        [ -f "$p" ] || { echo "✗ 插件不存在: $1"; exit 1; }
        "$PYV" "$p" "$@" ;;
      *) echo "用法: anote plugin {list|add|run}"; exit 1 ;;
    esac ;;
  wiki)
    # anote wiki [--dry] [--branch 学科/分支] [--force] —— 知识编译层
    python3 "$SKILL/wiki.py" "$@" ;;
  meta)
    # anote meta [--ai] [--apply] —— META 元数据检查/补全
    python3 "$SKILL/meta.py" "$@" ;;
  backlinks)
    # anote backlinks "<概念>" —— 反链视图
    [ -z "$1" ] && { echo "用法: anote backlinks \"<概念>\""; exit 1; }
    python3 "$SKILL/backlinks.py" "$1" ;;
  index)
    python3 "$SKILL/index-gen.py" ;;
  index-semantic)
    HF_ENDPOINT=https://hf-mirror.com "$PYV" "$SKILL/embed.py" "$@" ;;
  check)
    python3 "$SKILL/check.py" ;;
  stats)
    python3 "$SKILL/stats.py" "${@:1}" ;;
  migrate)
    # anote migrate --to <新路径> [--preview] [--force] [--with-env]
    python3 "$SKILL/migrate.py" "$@" ;;
  review)
    python3 "$SKILL/review.py" "$@" ;;
  daily)
    f=$("$PYV" "$SKILL/daily.py")
    echo "✓ 今日笔记: $f"
    "${EDITOR_CFG:-code}" "$f" 2>/dev/null || true ;;
  project)
    name="$1"; goal="$2"
    [ -z "$name" ] && { echo "用法: anote project <名> [目标]"; exit 1; }
    d="$DATA/projects/$name"; mkdir -p "$d"
    cp "$DATA/projects/_template/plan.tex" "$d/plan.tex" 2>/dev/null || true
    cp "$DATA/projects/_template/log.tex" "$d/log.tex" 2>/dev/null || true
    echo "✓ 项目已创建: $d" ;;
  book)
    name="$1"; author="${2:-作者}"
    [ -z "$name" ] && { echo "用法: anote book <书名> [作者]"; exit 1; }
    d="$DATA/books/$name"; mkdir -p "$d/chapters" "$d/figures"
    cp "$DATA/books/_template/main.tex" "$d/main.tex" 2>/dev/null || true
    cp "$DATA/books/_template/chapters/ch01.tex" "$d/chapters/ch01.tex" 2>/dev/null || true
    cp "$DATA/books/_template/refs.bib" "$d/refs.bib" 2>/dev/null || true
    cp "$DATA/books/_template/latexmkrc" "$d/latexmkrc" 2>/dev/null || true
    sed -i "s/书名（在 manage.sh book 生成时填入）/$name/" "$d/main.tex" 2>/dev/null || true
    echo "✓ 教科书已创建: $d（anote book-build \"$name\" 编译）" ;;
  chapter)
    book="$1"; title="$2"
    [ -z "$book" ] || [ -z "$title" ] && { echo "用法: anote chapter <书名> <章名>"; exit 1; }
    d="$DATA/books/$book/chapters"
    n=$(ls "$d" 2>/dev/null | wc -l); n=$((n+1))
    f="$d/ch$(printf %02d $n).tex"
    printf '%%%% ===== 第 %d 章 =====\\n\\\\chapter{%s}\\n\\\\label{ch:auto%d}\\n\\n正文从这里写起。\\n' "$n" "$title" "$n" > "$f"
    echo "✓ 章节已创建: $f" ;;
  book-build)
    name="$1"; [ -z "$name" ] && { echo "用法: anote book-build <书名>"; exit 1; }
    cd "$DATA/books/$name" && latexmk -lualatex -interaction=nonstopmode main.tex 2>&1 | tail -3 ;;
  commit)
    cd "$DATA" && git add -A && git commit -m "${1:-update}" ;;
  backup)
    cd "$DATA" && git add -A && git commit -m "backup: $(date '+%Y-%m-%d %H:%M')" || echo "无新变更"
    if git remote -v | grep -q push; then git push && echo "✅ 已推送远程"
    else echo "⚠️ 未配置远程: git remote add origin <gitee 地址>"; fi ;;
  *)
    echo "未知命令: $cmd"; usage; exit 1 ;;
esac
